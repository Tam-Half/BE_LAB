{
  "compilerOptions": {
    "target": "es2021",
    "module": "node16",           // <-- Đã cập nhật để đồng bộ với moduleResolution
    "moduleResolution": "node16", // <-- Giữ nguyên chuẩn mới
    "lib": [
      "es2021",                   // <-- Bổ sung thư viện chuẩn của ES2021
      "dom"
    ],
    "outDir": "./build",
    "rootDir": "./src",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "express", "multer"]
  },
  "include": [
    "src/**/*"                    // Đảm bảo TS chỉ biên dịch các file trong thư mục src
  ],
  "exclude": [
    "node_modules",               // Bỏ qua thư viện
    "build"                       // Bỏ qua thư mục đã build
  ]
}